# Secrets for deploy/compose.yaml. Copy to deploy/.env (git-ignored) and replace
# every value. Generate passwords with: openssl rand -base64 32

SALIO_DB_NAME=salio_v2

# Only used by PostgreSQL itself and the one-off role setup.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me

# Owns the schema; used only by the migration step.
SALIO_OWNER_USER=salio_owner
SALIO_OWNER_PASSWORD=change-me

# What the API and the sweep connect as. Not a superuser, no BYPASSRLS.
SALIO_APP_USER=salio_app
SALIO_APP_PASSWORD=change-me

# At least 32 characters: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-of-48-chars

API_PORT=8090
ALLOWED_ORIGINS=
