# ==============================================================================
# Salio v2 — example environment
# Copy to .env and fill in. Tusk's config loader fails fast on startup if
# anything required here is missing or invalid, rather than misbehaving later.
# ==============================================================================

APP_NAME=Salio
APP_VERSION=2.0.0-dev
# dev | staging | production. Production changes several defaults — see below.
APP_MODE=dev
SERVER_PORT=8090

# Comma-separated. Leave empty to allow no cross-origin browser requests.
ALLOWED_ORIGINS=

# --- Security -----------------------------------------------------------------
# REQUIRED. Minimum 32 characters — HS256 signatures are only as strong as this
# key, so a short one lets an attacker mint valid tokens for any business.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Database -----------------------------------------------------------------
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=salio_v2
DB_USER=root
DB_PASS=

# disable | require | verify-ca | verify-full
# Defaults to "require" when APP_MODE=production, "disable" otherwise.
# DB_SSLMODE=require

# --- API documentation --------------------------------------------------------
# Serves /docs and /openapi.json. Defaults to false when APP_MODE=production,
# true otherwise. API endpoints are unaffected either way — this only controls
# whether the route map and schemas are published.
DOCS_ENABLED=true

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug
