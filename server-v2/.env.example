# ==============================================================================
# Salio v2 — example environment
# Copy to .env and fill in. Tusk's config loader fails fast on startup if
# anything required here is missing or invalid, rather than misbehaving later.
# ==============================================================================

APP_NAME=Salio
APP_VERSION=2.0.0-dev
# dev | staging | production. Production changes several defaults — see below.
APP_MODE=dev
SERVER_PORT=8090

# Comma-separated. Leave empty to allow no cross-origin browser requests.
ALLOWED_ORIGINS=

# --- Security -----------------------------------------------------------------
# REQUIRED. Minimum 32 characters — HS256 signatures are only as strong as this
# key, so a short one lets an attacker mint valid tokens for any business.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# --- Database ---------------------------------------------------------------
# Two roles, as in production (deploy/postgres/roles.sql, docs/09-operations.md):
#
#   DB_USER            the APP role the API connects as. Not a superuser and no
#                      BYPASSRLS, so PostgreSQL's row-level security applies.
#   MIGRATION_DB_USER  the OWNER role migrations run as. Only cmd/migrate uses it.
#
# One-off setup on a fresh database:  make db-roles  (uses DB_ADMIN_URL), then
# make migrate-up. `make dev` and `make run` migrate before starting.
DB_DRIVER=postgres
DB_HOST=127.0.0.1
DB_PORT=5434
DB_NAME=salio_v2
DB_USER=salio_app
DB_PASS=
MIGRATION_DB_USER=salio_owner
MIGRATION_DB_PASS=
# A superuser, used only by `make db-roles`.
DB_ADMIN_URL=postgres://root:root@127.0.0.1:5434/salio_v2

# The app role cannot change the schema, so it cannot migrate at start-up.
MIGRATE_ON_BOOT=false
# Refuse to start as a role that bypasses row-level security. Defaults to true
# when APP_MODE=production; worth keeping on in development too.
REQUIRE_RLS=true

# disable | require | verify-ca | verify-full
# Defaults to "require" when APP_MODE=production, "disable" otherwise.
# DB_SSLMODE=require

# --- API documentation --------------------------------------------------------
# Serves /docs and /openapi.json. Defaults to false when APP_MODE=production,
# true otherwise. API endpoints are unaffected either way — this only controls
# whether the route map and schemas are published.
DOCS_ENABLED=true

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug
