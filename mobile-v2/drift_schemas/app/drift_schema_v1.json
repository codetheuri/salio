  "fixed_sql": [
    {
      "name": "customers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"customers\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"sync_state\" INTEGER NOT NULL, \"local_version\" INTEGER NOT NULL DEFAULT 0, \"name\" TEXT NOT NULL, \"phone\" TEXT NULL, \"notes\" TEXT NULL, \"created_by\" TEXT NOT NULL, \"credit_limit_cents\" INTEGER NULL, \"changed_fields\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ledger_entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ledger_entries\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"is_deleted\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_deleted\" IN (0, 1)), \"sync_state\" INTEGER NOT NULL, \"local_version\" INTEGER NOT NULL DEFAULT 0, \"customer_id\" TEXT NOT NULL REFERENCES customers (id), \"user_id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"description\" TEXT NULL, \"transaction_date\" TEXT NOT NULL, \"payment_method\" TEXT NULL, \"reference\" TEXT NULL, \"due_date\" TEXT NULL, \"sale_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sync_meta",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_meta\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    },
    {
      "name": "push_batches",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"push_batches\" (\"operation_id\" TEXT NOT NULL, \"body\" TEXT NOT NULL, \"records\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"attempts\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"operation_id\"));"
        }
      ]
    },
    {
      "name": "sync_issues",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_issues\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"record_table\" TEXT NOT NULL, \"record_id\" TEXT NOT NULL, \"field\" TEXT NULL, \"reason\" TEXT NOT NULL, \"detail\" TEXT NULL, \"created_at\" TEXT NOT NULL);"
        }
      ]
